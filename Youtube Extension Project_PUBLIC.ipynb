    "video_urls = [\n",
    "    \"https://www.youtube.com/watch?v=kJQP7kiw5Fk\",\n",
    "    \"https://www.youtube.com/watch?v=VAZSnmwD8ws\",\n",
    "    \"https://www.youtube.com/watch?v=iqGAW57EudQ&list=RD-s1Cc2uEj3U&index=3\",\n",
    "    \"https://www.youtube.com/watch?v=0mADjFrSVcU\",\n",
    "    \"https://www.youtube.com/watch?v=KwBuV7YZido\",\n",
    "    \"https://www.youtube.com/watch?v=oz9cEqFynHU\"\n",
    "    # more urls are possible\n",
    "]\n",
    "\n",
    "results = []\n",
    "for url in video_urls:\n",
    "    vid = extract_video_id(url)\n",
    "    if not vid:\n",
    "        print(\"Invalid URL:\", url)\n",
    "        continue\n",
    "    print(\"Processing:\", vid)\n",
    "    meta = fetch_video_metadata(youtube, vid)\n",
    "    comments_df = fetch_comments(youtube, vid, max_comments=5000)\n",
    "    print(\"Fetched comments:\", len(comments_df))\n",
    "    sampled = sample_comments_dynamic(comments_df, ratio=0.3, max_total=2000, min_total=200)\n",
    "    print(\"Sampled:\", len(sampled))\n",
    "    processed_df, avg_sent, weighted_sent, extras = analyze_comments(sampled, batch_size=32)\n",
    "    topics = extract_topics(processed_df['clean_text'].tolist())\n",
    "    result = {\n",
    "        \"video_id\": vid,\n",
    "        \"title\": meta.get('title'),\n",
    "        \"channel\": meta.get('channelTitle'),\n",
    "        \"publishedAt\": meta.get('publishedAt'),\n",
    "        \"views\": meta.get('views'),\n",
    "        \"likes\": meta.get('likes'),\n",
    "        \"sample_size\": len(sampled),\n",
    "        \"languages\": extras['lang_dist'],\n",
    "        \"top_keywords\": extras['top_keywords'],\n",
    "        \"avg_sentiment_unweighted\": round(avg_sent, 2),\n",
    "        \"avg_sentiment_weighted\": round(weighted_sent, 2),\n",
    "        \"topics\": topics\n",
    "    }\n",
    "    results.append(result)"
   ]
