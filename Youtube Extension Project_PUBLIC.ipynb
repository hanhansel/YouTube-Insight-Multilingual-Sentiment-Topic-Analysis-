   "source": [
    "# remove URLs\n",
    "def remove_urls(text):\n",
    "    return re.sub(r\"http\\S+|www\\.\\S+\", \"\", text)\n",
    "\n",
    "# remove embedded htmls\n",
    "def remove_html(text):\n",
    "    return re.sub(r\"<.*?>\", \"\", text)\n",
    "\n",
    "# remove trailing whitespace\n",
    "def remove_extra_whitespace(text):\n",
    "    return re.sub(r\"\\s+\", \" \", text).strip()\n",
    "\n",
    "# remove emojis\n",
    "def remove_emojis(text):\n",
    "    return emoji.replace_emoji(text, replace='')\n",
    "\n",
    "# remove any other weird letters using regex\n",
    "def remove_nonletters_keep_accents(text):\n",
    "    return re.sub(r\"[^0-9A-Za-zÀ-ž\\s\\-\\_']\", \" \", text)\n",
    "\n",
    "# remove years and dates\n",
    "def remove_dates_numbers(text):\n",
    "    text = re.sub(r'\\b(19|20)\\d{2}\\b', '', text)\n",
    "    text = re.sub(r'\\d{2,}', '', text)\n",
    "    return text\n",
    "\n",
    "# clear everything based on the fucntions above \n",
    "def basic_clean(text):\n",
    "    if not isinstance(text, str): \n",
    "        return \"\"\n",
    "    text = text.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n",
    "    text = remove_html(text)\n",
    "    text = remove_urls(text)\n",
    "    text = remove_emojis(text)\n",
    "    text = remove_dates_numbers(text)\n",
    "    text = remove_nonletters_keep_accents(text)\n",
    "    text = remove_extra_whitespace(text)\n",
    "    return text.lower()"
   ]
  },
  {
