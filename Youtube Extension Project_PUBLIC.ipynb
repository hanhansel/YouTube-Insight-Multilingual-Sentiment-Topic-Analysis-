    "# rake setup for keywords\n",
    "# I think it's better to change into KeyBert since it gives more contextual meaning, and change the top_n = 3 so UI is cleaner\n",
    "\n",
    "PRIOR_LANGS = [\"en\",\"hi\",\"es\",\"ru\",\"vi\",\"de\",\"fr\",\"pt\",\"id\",\"pl\",\"tl\",\"tr\"]  # includes tagalog and Turkish \n",
    "rake_models = {}\n",
    "for lang in PRIOR_LANGS:\n",
    "    try:\n",
    "        rake_models[lang] = Rake(language_code=lang)\n",
    "    except Exception:\n",
    "        rake_models[lang] = Rake(language_code=\"en\")  # fallback\n",
    "rake_en = Rake(language_code=\"en\")\n",
    "\n",
    "def extract_keywords_rake(text, lang=None, top_k=5):\n",
    "    if not text or not isinstance(text, str):\n",
    "        return []\n",
    "    lang_code = lang if lang in rake_models else None\n",
    "    r = rake_models.get(lang_code, rake_en)\n",
    "    try:\n",
    "        kw = r.apply(text)\n",
    "        # kw is list of tuples (phrase, score)\n",
    "        return [p for p,s in kw[:top_k]]\n",
    "    except Exception:\n",
    "        return []"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "6d34f624-0dfc-4e02-94bf-0d07c9a16d36",
   "metadata": {},
   "outputs": [],
   "source": [
    "# bert setup for topics\n",
    "\n",
    "embed_model_name = 'paraphrase-multilingual-MiniLM-L12-v2'\n",
    "embedding_model = SentenceTransformer(embed_model_name, device=device)\n",
    "topic_model = BERTopic(language=\"multilingual\", embedding_model=embedding_model, top_n_words=5, min_topic_size=5) # bisa diganti ke 3\n",
    "\n",
    "def extract_topics(texts, top_n=5): # bisa diganti jg ke 3\n",
    "    if not texts:\n",
    "        return {}\n",
    "    topics, probs = topic_model.fit_transform(texts)\n",
    "    topic_info = topic_model.get_topic_info()\n",
    "    topics_dict = {}\n",
    "    # choose top_n topics by size\n",
    "    top_topics = topic_info[topic_info.Topic != -1].head(top_n)\n",
    "    for tid in top_topics.Topic:\n",
    "        keywords = [w for w,_ in topic_model.get_topic(tid)]\n",
    "        topics_dict[f\"Topic {tid}\"] = keywords\n",
    "    return topics_dict"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "efead0d8-7ed8-4bef-91d8-392921b796f3",
   "metadata": {},
