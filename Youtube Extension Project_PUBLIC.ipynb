   "source": [
    "# from the 5k comments, we can sample comments using top liked, top replied, most recent, and random, and use a \n",
    "# ratio so that we take 30% of 5k (if possible). The sampling is also biased so that high engagement comments are \n",
    "# more likely to be included, since they often represent the opinions that resonated most with the audience.\n",
    "# the sampling is done to reduce the overall load to the model, but can be adjusted to our personal/corporate needs\n",
    "def sample_comments_dynamic(df, ratio=0.3, max_total=2000, min_total=200):\n",
    "    if len(df) == 0:\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    target_size = int(len(df) * ratio)\n",
    "    target_size = min(max_total, target_size)\n",
    "    target_size = max(min_total, target_size)\n",
    "    \n",
    "    per_category = target_size // 4\n",
    "    # top liked\n",
    "    top_liked = df.sort_values('likeCount', ascending=False).head(per_category)\n",
    "    # top replied\n",
    "    top_replied = df.sort_values('replyCount', ascending=False).head(per_category)\n",
    "    # recent\n",
    "    recent = df.sort_values('publishedAt', ascending=False).head(per_category)\n",
    "    # random\n",
    "    remaining = df.drop(pd.concat([top_liked, top_replied, recent]).index)\n",
    "    random_sample = remaining.sample(\n",
    "        min(per_category, len(remaining)), random_state=42\n",
    "    ) if len(remaining) > 0 else pd.DataFrame()\n",
    "    # combining\n",
    "    sampled = pd.concat([top_liked, top_replied, recent, random_sample]) \\\n",
    "                .drop_duplicates().reset_index(drop=True)\n",
    "    \n",
    "    return sampled"
   ]
  },
