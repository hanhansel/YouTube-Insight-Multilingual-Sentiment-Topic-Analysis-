    "# check youtube URLs and extract them\n",
    "def extract_video_id(url):\n",
    "    if re.match(r'^[\\w\\-]{11}$', url): #take only 11 to prevent malformed IDs\n",
    "        return url\n",
    "    parsed = urlparse(url)\n",
    "    if 'youtube.com' in parsed.netloc:\n",
    "        qs = parse_qs(parsed.query)\n",
    "        if 'v' in qs:\n",
    "            return qs['v'][0]\n",
    "    if 'youtu.be' in parsed.netloc:\n",
    "        return parsed.path.lstrip('/')\n",
    "    return None\n",
    "\n",
    "# fetch comments from YouTube URLs with the max comments cap of 5000 (pagination)\n",
    "# since youtube's API only returns at most 100 top comments per call, we have to use pagination and looping\n",
    "# with the nextPageToken to fetch additional batches. This loop continues until we reach the 5,000 comment cap \n",
    "# or there are no more comments, ensuring a larger and representative dataset while staying within safe limits.\n",
    "def fetch_comments(youtube, video_id, max_comments=5000):\n",
    "    comments = []\n",
    "    request = youtube.commentThreads().list(\n",
    "        part=\"snippet\",\n",
    "        videoId=video_id,\n",
    "        textFormat=\"plainText\",\n",
    "        maxResults=100\n",
    "    )\n",
    "    while request and len(comments) < max_comments:\n",
    "        try:\n",
    "            response = request.execute()\n",
    "        except Exception as e:\n",
    "            print(f\"Error fetching comments for video {video_id}: {e}\")\n",
    "            break\n",
    "        for item in response.get('items', []):\n",
    "            snippet = item['snippet']['topLevelComment']['snippet']\n",
    "            text = snippet.get('textDisplay', '')\n",
    "            comments.append({\n",
    "                'text': text,\n",
    "                'likeCount': int(snippet.get('likeCount', 0)), #used for weighted sentiment later\n",
    "                'replyCount': int(item['snippet'].get('totalReplyCount', 0)), #used for weighted sentiment later\n",
    "                'publishedAt': snippet.get('publishedAt') #used for recency\n",
    "            })\n",
    "            if len(comments) >= max_comments:\n",
    "                break\n",
    "        sleep(1)  # simple backoff \n",
    "        request = youtube.commentThreads().list_next(request, response)\n",
    "    return pd.DataFrame(comments)\n",
    "\n",
    "# fetching other video data like views and likes\n",
    "def fetch_video_metadata(youtube, video_id):\n",
    "    response = youtube.videos().list(part=\"snippet,statistics\", id=video_id).execute()\n",
    "    if not response['items']:\n",
    "        return {}\n",
    "    item = response['items'][0]\n",
    "    snippet = item['snippet']\n",
    "    stats = item.get('statistics', {})\n",
    "    return {\n",
    "        'title': snippet.get('title'),\n",
    "        'description': snippet.get('description'),\n",
    "        'channelTitle': snippet.get('channelTitle'),\n",
    "        'publishedAt': snippet.get('publishedAt'),\n",
    "        'views': int(stats.get('viewCount', 0)),\n",
    "        'likes': int(stats.get('likeCount', 0)) if stats.get('likeCount') else 0,\n",
    "        'commentCount': int(stats.get('commentCount', 0)) if stats.get('commentCount') else 0\n",
    "    }"
   ]
  },
