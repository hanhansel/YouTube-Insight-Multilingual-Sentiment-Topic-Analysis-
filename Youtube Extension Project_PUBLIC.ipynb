   "source": [
    "def analyze_comments(sampled_df, batch_size=32):\n",
    "    if sampled_df.empty:\n",
    "        return sampled_df, 0.0, 0.0, {}\n",
    "\n",
    "    # language detection\n",
    "    def safe_detect(t):\n",
    "        try:\n",
    "            return detect(t)\n",
    "        except:\n",
    "            return \"unknown\"\n",
    "\n",
    "    sampled_df['language'] = sampled_df['text'].apply(lambda x: safe_detect(x) if x else \"unknown\") #bisa di ganti ke fasttext\n",
    "\n",
    "    # clean text (keeps accents)\n",
    "    sampled_df['clean_text'] = sampled_df['text'].apply(lambda t: basic_clean(t))\n",
    "\n",
    "    # prepare texts for sentiment (we feed cleaned text)\n",
    "    texts = sampled_df['clean_text'].fillna(\"\").tolist()\n",
    "    # compute sentiment numeric scores in batches\n",
    "    sentiment_scores = batch_sentiment_scores(texts, batch_size=batch_size, max_length=512)\n",
    "    sampled_df['sentimentScore'] = sentiment_scores\n",
    "\n",
    "    # checking tokenized length\n",
    "    token_lens = []\n",
    "    for t in texts:\n",
    "        tokenized = tokenizer(t, truncation=False, add_special_tokens=True)\n",
    "        token_lens.append(len(tokenized['input_ids']))\n",
    "    sampled_df['token_len'] = token_lens\n",
    "    sampled_df['wasTruncated'] = sampled_df['token_len'] > 512\n",
    "\n",
    "    # keyword extraction with RAKE (language-aware)\n",
    "    keywords_list = []\n",
    "    for idx, row in sampled_df.iterrows():\n",
    "        lang = row['language']\n",
    "        kw = extract_keywords_rake(row['clean_text'], lang=lang, top_k=5)\n",
    "        keywords_list.append(kw)\n",
    "    sampled_df['rake_keywords'] = keywords_list\n",
    "\n",
    "    # weighted sentiment: use log1p of likes/replies to avoid extreme weights\n",
    "    # why log1p? because it can dampens huge comments which may biased, thats why we'll make it fair\n",
    "    # but it may benefit to use linear and raw comments to highlight which comments represent the public's opinion\n",
    "    weights = 1.0 + np.log1p(sampled_df['likeCount'].values.astype(float)) + np.log1p(sampled_df['replyCount'].values.astype(float))\n",
    "    # if all zeros / ones, weights become 1.0; safe\n",
    "    weighted_avg = float(np.average(sampled_df['sentimentScore'].values, weights=weights))\n",
    "\n",
    "    # simple unweighted average\n",
    "    unweighted_avg = float(np.mean(sampled_df['sentimentScore'].values))\n",
    "\n",
    "    # aggregate top keywords (RAKE output) across sample (flatten and count)\n",
    "    flat_keywords = [kw.lower() for kws in keywords_list for kw in kws]\n",
    "    top_keywords_counts = Counter(flat_keywords).most_common(10)\n",
    "    top_keywords = [k for k,_ in top_keywords_counts]\n",
    "\n",
    "    # detect languages distribution\n",
    "    lang_dist = sampled_df['language'].value_counts().to_dict()\n",
    "    return sampled_df, unweighted_avg, weighted_avg, {\"top_keywords\": top_keywords, \"lang_dist\": lang_dist} "
   ]
  },
