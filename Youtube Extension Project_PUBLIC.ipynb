   "source": [
    "def summarize_result_structured(res, top_n_topics=5, top_n_langs=5):\n",
    "    topic_items = list(res['topics'].items())[:top_n_topics]\n",
    "    topic_cols = {}\n",
    "    for i in range(top_n_topics):\n",
    "        if i < len(topic_items):\n",
    "            tname, words = topic_items[i]\n",
    "            topic_cols[f\"TopTopic_{i+1}\"] = f\"{tname}: {', '.join(words)}\"\n",
    "        else:\n",
    "            topic_cols[f\"TopTopic_{i+1}\"] = \"\"\n",
    "    langs = sorted(res['languages'].items(), key=lambda x: x[1], reverse=True)[:top_n_langs]\n",
    "    lang_summary = \", \".join([f\"{k}({v})\" for k, v in langs])\n",
    "    keywords = \", \".join(res['top_keywords'])\n",
    "    return {\n",
    "        \"Video ID\": res['video_id'],\n",
    "        \"Title\": res['title'],\n",
    "        \"Channel\": res['channel'],\n",
    "        \"Published\": (res['publishedAt'][:10] if res.get('publishedAt') else \"\"),\n",
    "        \"Views\": res.get('views', 0),\n",
    "        \"Likes\": res.get('likes', 0),\n",
    "        \"Sample Size\": res.get('sample_size', 0),\n",
    "        \"Avg Sentiment (unw)\": res['avg_sentiment_unweighted'],\n",
    "        \"Avg Sentiment (wtd)\": res['avg_sentiment_weighted'],\n",
    "        \"Languages\": lang_summary,\n",
    "        \"Keywords\": keywords,\n",
    "        **topic_cols\n",
    "    }\n",
    "\n",
    "df_structured = pd.DataFrame([summarize_result_structured(r, top_n_topics=5) for r in results])\n",
    "pd.set_option(\"display.max_colwidth\", 200)\n",
    "display(df_structured)\n",
    "df_structured.to_csv(\"youtube_summary_tabularis.csv\", index=False)"
   ]
  }
